<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget on Android 12+: one flat layout whose children are sized and placed from code (AuralysWidgetLayout),
  so the same views fit any widget size, from 1x1 to a tall 2x4. Every child sits at the top-left of the frame;
  its width, height and margins are set per widget size with RemoteViews.setViewLayout*.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/aw_bg"
        android:src="@drawable/aw_preview_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/aw_cover"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="@string/album_art"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/aw_title"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/no_song_playing"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aw_artist"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/tap_to_open"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/aw_like_box"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start">
        <ImageView
            android:id="@+id/aw_like"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/like"
            android:src="@drawable/aw_heart_outline" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/aw_prev_box"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start">
        <ImageView
            android:id="@+id/aw_prev"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/aw_previous"
            android:src="@drawable/aw_prev" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/aw_play_box"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start">
        <ImageView
            android:id="@+id/aw_play_bg"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/aw_circle" />
        <ImageView
            android:id="@+id/aw_play"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/play_pause"
            android:src="@drawable/aw_play" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/aw_next_box"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start">
        <ImageView
            android:id="@+id/aw_next"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/aw_next"
            android:src="@drawable/aw_next" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/aw_progress_box"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start">
        <ImageView
            android:id="@+id/aw_progress_track"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/aw_progress_track" />
        <ImageView
            android:id="@+id/aw_progress_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/aw_progress_clip" />
    </FrameLayout>

    <TextView
        android:id="@+id/aw_time_now"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="0:00"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/aw_time_total"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:gravity="end|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="0:00"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/aw_streak"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/aw_streak_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_streak_flame" />
        <TextView
            android:id="@+id/aw_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
