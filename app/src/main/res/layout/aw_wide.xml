<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/aw_bg"
        android:src="@drawable/aw_preview_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">
        <ImageView
            android:id="@+id/aw_cover"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/album_art"
            android:scaleType="fitCenter"
            android:src="@drawable/aw_preview_cover" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/aw_title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/no_song_playing"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/aw_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/aw_streak_icon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_streak_flame" />
                    <TextView
                        android:id="@+id/aw_streak_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/aw_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tap_to_open"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/aw_like_box"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/aw_like"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/like"
                    android:src="@drawable/aw_heart_outline" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/aw_prev_box"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/aw_prev"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/aw_previous"
                    android:src="@drawable/aw_prev" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/aw_play_box"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/aw_play_bg"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/aw_circle" />
                <ImageView
                    android:id="@+id/aw_play"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/play_pause"
                    android:src="@drawable/aw_play" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/aw_next_box"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/aw_next"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/aw_next"
                    android:src="@drawable/aw_next" />
            </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/aw_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/aw_time_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp" />
                <FrameLayout
                    android:id="@+id/aw_progress_box"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/aw_progress_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/aw_progress_track" />
                    <ImageView
                        android:id="@+id/aw_progress_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/aw_progress_clip" />
                </FrameLayout>
                <TextView
                    android:id="@+id/aw_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
